# Pinned tool versions. Changing a version here is a reviewable commit, and the
# checksum below must be updated with it — an unpinned tool means CI and a local
# machine can disagree about whether the code passes.
SWIFTLINT_VERSION=0.65.0
SWIFTLINT_SHA256=d6cb0aa7a2f5f1ef306fc9e37bcb54dc9a26facc8f7784ac0c3dd3eccf5c6ba6
XCODEGEN_VERSION=2.46.0
XCODEGEN_SHA256=4d9e34b62172d645eed6457cac13fc222569974098ef4ee9c3368bedf0196806

# The toolchain the checks are known to pass on.
#
# PREFERRED is used when present; otherwise the newest installed Xcode is used
# provided it meets MIN. Pinning only an exact path is a bet that a specific
# bundle exists on the machine, which is false on most runner images and stops
# being true on the rest whenever the image updates.
XCODE_PREFERRED_VERSION=26.6
XCODE_MIN_VERSION=26.0
SIMULATOR_NAME="iPhone 17"
